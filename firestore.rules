rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "crowdfundpersonal@gmail.com";
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /campaigns/{campaignId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerAddress == request.auth.uid;

      // Only the admin can mark a payout as sent. Any other authenticated
      // user may only ever touch amountCollectedCents (the donation-total
      // counter updated as part of the donate() transaction).
      allow update: if
        (isAdmin() && affectedKeys().hasOnly(["payoutSentAt", "payoutTransactionId"]))
        || (isSignedIn() && affectedKeys().hasOnly(["amountCollectedCents"]));

      allow delete: if false;

      match /donations/{donationId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.donatorAddress == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /balances/{address} {
      allow read, write: if isSignedIn() && request.auth.uid == address;
    }
  }
}
