rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "crowdfundpersonal@gmail.com";
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /campaigns/{campaignId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerAddress == request.auth.uid;

      // The admin can edit any field (payouts, or full campaign edits).
      // Any other authenticated user may only ever touch
      // amountCollectedCents (the donation-total counter updated as part
      // of the donate() transaction).
      allow update: if
        isAdmin()
        || (isSignedIn() && affectedKeys().hasOnly(["amountCollectedCents"]));

      allow delete: if isAdmin();

      match /donations/{donationId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.donatorAddress == request.auth.uid;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        function oldLikes() {
          return "likedBy" in resource.data ? resource.data.likedBy : [];
        }

        // A like-toggle may only ever add or remove the caller's own uid
        // from likedBy — never touch anyone else's entry.
        function isOwnLikeToggle() {
          return affectedKeys().hasOnly(["likedBy"])
            && request.resource.data.likedBy.toSet().difference(oldLikes().toSet()).hasOnly([request.auth.uid])
            && oldLikes().toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid]);
        }

        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.parentId == null || request.resource.data.parentId is string)
          && request.resource.data.likedBy == [];

        // Either the original author edits their own text, or any signed
        // in user toggles their own like — everything else (author
        // identity, createdAt, parentId) is immutable.
        allow update: if isSignedIn()
          && (
            (resource.data.authorUid == request.auth.uid
              && affectedKeys().hasOnly(["text", "editedAt"])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000)
            || isOwnLikeToggle()
          );

        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /balances/{address} {
      allow read, write: if isSignedIn() && request.auth.uid == address;
    }

    // Platform-wide config, e.g. the PayPal sandbox/live mode toggle.
    // Client IDs are public by nature (embedded in any page that loads the
    // PayPal SDK), so a public-read doc is fine; only the admin can write.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
