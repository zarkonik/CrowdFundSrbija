rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /campaign-images/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");

      allow delete: if false;
    }

    // Profile photos are namespaced by uid in the filename (enforced
    // below), so a user can only ever overwrite their own.
    match /profile-images/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + "-.*")
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");

      allow delete: if false;
    }

    // Everything else is denied by default (no matching rule = no access).
  }
}
